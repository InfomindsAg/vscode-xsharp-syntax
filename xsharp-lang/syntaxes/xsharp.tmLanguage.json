{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "X#",
	"fileTypes": [
		"prg"
	],
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#preprocessor"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#literal"
		},
		{
			"include": "#member"
		},
		{
			"include": "#entity"
		},
		{
			"include": "#type"
		},
		{
			"include": "#expression"
		},
		{
			"include": "#variable"
		},
		{
			"include": "#control-keywords"
		},
		{
			"include": "#as"
		},
		{
			"include": "#block"
		},
		{
			"include": "#keywords"
		}
	],
	"repository": {
		"comment": {
			"patterns": [
				{
					"match": "///.*$",
					"name": "comment.block.documentation.prg"
				},
				{
					"match": "//.*$",
					"name": "comment.line.double-slash.prg"
				},
				{
					"match": "&&.*$",
					"name": "comment.line.double-ampersand.prg"
				},
				{
					"match": "^\\s*\\*.*$",
					"name": "comment.line.asterisk.prg"
				},
				{
					"begin": "/\\*",
					"end": "\\*/",
					"name": "comment.block.prg"
				}
			]
		},
		"preprocessor": {
			"begin": "(?i)^\\s*(#(?:command|xcommand|ycommand|translate|xtranslate|ytranslate|define|undef|ifdef|ifndef|if|else|endif|include|region|endregion|pragma|warning|error|line|stdout|text|endtext|nullable|using))\\b",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.directive.prg"
				}
			},
			"end": "$",
			"name": "meta.preprocessor.prg",
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#numeric-literal"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"include": "#string-interpolated-escaped"
				},
				{
					"include": "#string-escaped"
				},
				{
					"include": "#string-interpolated"
				},
				{
					"include": "#char-single"
				},
				{
					"include": "#char-double"
				},
				{
					"include": "#string-double"
				},
				{
					"include": "#string-single"
				},
				{
					"include": "#string-bracket"
				}
			]
		},
		"string-escape": {
			"match": "\\\\.",
			"name": "constant.character.escape.prg"
		},
		"string-interpolation": {
			"match": "\\{[^}]*\\}",
			"name": "meta.interpolation.prg"
		},
		"string-interpolated-escaped": {
			"name": "string.quoted.double.prg",
			"begin": "(?i)\\b(?:ie|ei)\"",
			"end": "\"|$",
			"patterns": [
				{
					"include": "#string-escape"
				},
				{
					"include": "#string-interpolation"
				}
			]
		},
		"string-escaped": {
			"name": "string.quoted.double.prg",
			"begin": "(?i)\\be\"",
			"end": "\"|$",
			"patterns": [
				{
					"include": "#string-escape"
				}
			]
		},
		"string-interpolated": {
			"name": "string.quoted.double.prg",
			"begin": "(?i)\\bi\"",
			"end": "\"|$",
			"patterns": [
				{
					"include": "#string-interpolation"
				}
			]
		},
		"char-single": {
			"name": "string.quoted.single.prg",
			"begin": "(?i)\\bc'",
			"end": "'|$",
			"patterns": [
				{
					"include": "#string-escape"
				}
			]
		},
		"char-double": {
			"name": "string.quoted.double.prg",
			"begin": "(?i)\\bc\"",
			"end": "\"|$",
			"patterns": [
				{
					"include": "#string-escape"
				}
			]
		},
		"string-double": {
			"name": "string.quoted.double.prg",
			"begin": "\"",
			"end": "\"|$"
		},
		"string-single": {
			"name": "string.quoted.single.prg",
			"begin": "'",
			"end": "'|$"
		},
		"string-bracket": {
			"name": "string.quoted.other.bracket.prg",
			"begin": "(?:(?<=[=(,{+])|(?i:(?<=\\breturn))|(?i:(?<=\\bget)))\\s*(\\[)",
			"end": "\\]|$"
		},
		"literal": {
			"patterns": [
				{
					"include": "#numeric-literal"
				},
				{
					"include": "#boolean-literal"
				},
				{
					"include": "#null-literal"
				},
				{
					"include": "#symbol-literal"
				},
				{
					"include": "#macro-literal"
				}
			]
		},
		"numeric-literal": {
			"patterns": [
				{
					"match": "(?i)\\{\\^\\d{4}-\\d{1,2}-\\d{1,2}(?:\\s+\\d{1,2}(?::\\d{1,2}){0,2}(?:\\s*[ap]m)?)?\\s*\\}",
					"name": "constant.numeric.date.prg"
				},
				{
					"match": "\\b\\d{4}\\.\\d{1,2}\\.\\d{1,2}\\b",
					"name": "constant.numeric.date.prg"
				},
				{
					"match": "(?i)\\b0x[0-9a-f_]+[ul]?\\b",
					"name": "constant.numeric.hex.prg"
				},
				{
					"match": "(?i)\\b0b[01_]+u?\\b",
					"name": "constant.numeric.binary.prg"
				},
				{
					"match": "(?i)\\b0h[0-9a-f]+\\b",
					"name": "constant.numeric.binary.prg"
				},
				{
					"match": "(?i)\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:e[+-]?\\d+)?[ulmsd]?\\b",
					"name": "constant.numeric.decimal.prg"
				},
				{
					"match": "(?i)(?<![\\w.])\\.\\d[\\d_]*(?:e[+-]?\\d+)?[msd]?\\b",
					"name": "constant.numeric.decimal.prg"
				},
				{
					"match": "(?<![\\w$])\\$\\d[\\d_]*(?:\\.\\d+)?\\b",
					"name": "constant.numeric.currency.prg"
				}
			]
		},
		"boolean-literal": {
			"patterns": [
				{
					"match": "(?i)(?<![\\w.])\\.(?:t|f|y|n)\\.",
					"name": "constant.language.boolean.prg"
				},
				{
					"match": "(?i)(?<![:.])\\b(?:true|false)\\b",
					"name": "constant.language.boolean.prg"
				}
			]
		},
		"null-literal": {
			"patterns": [
				{
					"match": "(?i)(?<![:.])\\b(?:NIL|NULL|NULL_ARRAY|NULL_CODEBLOCK|NULL_DATE|NULL_OBJECT|NULL_PSZ|NULL_PTR|NULL_STRING|NULL_SYMBOL)\\b",
					"name": "constant.language.null.prg"
				},
				{
					"match": "(?i)(?<![\\w.])\\.NULL\\.",
					"name": "constant.language.null.prg"
				}
			]
		},
		"symbol-literal": {
			"match": "#[A-Za-z_]\\w*",
			"name": "constant.other.symbol.prg"
		},
		"macro-literal": {
			"match": "(?i)\\b__[a-z0-9_]+__\\b",
			"name": "constant.language.macro.prg"
		},
		"member": {
			"match": "(?<=[\\w)\\]}])(?:(:)(?![:=])\\s*|(\\.)(?!(?i:and|or|not|xor|t|f|y|n|null)\\.))([A-Za-z_]\\w*)",
			"captures": {
				"3": {
					"name": "variable.other.member.prg"
				}
			}
		},
		"entity": {
			"patterns": [
				{
					"include": "#function"
				},
				{
					"match": "(?i)(?<![:.])\\b(?:CONSTRUCTOR|DESTRUCTOR)\\b",
					"name": "storage.type.function.prg"
				},
				{
					"include": "#define-global"
				},
				{
					"include": "#delegate-struct"
				},
				{
					"include": "#event"
				},
				{
					"include": "#class-enum-interface"
				},
				{
					"include": "#namespace"
				},
				{
					"include": "#property"
				},
				{
					"include": "#union-vostruct"
				},
				{
					"include": "#storage-modifier"
				}
			]
		},
		"function": {
			"patterns": [
				{
					"match": "(?i)(?<![:.])\\b(FUNC|FUNCTION|METHOD|PROC|PROCEDURE|ACCESS|ASSIGN)\\s+([A-Za-z_]\\w*)",
					"name": "meta.function.prg",
					"captures": {
						"1": {
							"name": "storage.type.function.prg"
						},
						"2": {
							"name": "entity.name.function.prg"
						}
					}
				},
				{
					"match": "(?i)\\b(?:ENDFUNC|END\\s+FUNCTION|END\\s+METHOD|ENDPROC|END\\s+PROCEDURE)\\b",
					"name": "keyword.other.prg"
				}
			]
		},
		"define-global": {
			"match": "(?i)(?<![:.])\\b(DEFINE|GLOBAL)\\s+(?:(CONST)\\s+)?([A-Za-z_]\\w*)",
			"captures": {
				"1": {
					"name": "keyword.other.prg"
				},
				"2": {
					"name": "storage.modifier.prg"
				},
				"3": {
					"name": "variable.other.constant.prg"
				}
			}
		},
		"delegate-struct": {
			"match": "(?i)(?<![:.])\\b(DELEGATE|VOSTRUCT|UNION)\\s+([A-Za-z_]\\w*)",
			"captures": {
				"1": {
					"name": "keyword.other.prg"
				},
				"2": {
					"name": "entity.name.type.prg"
				}
			}
		},
		"event": {
			"match": "(?i)(?<![:.])\\b(EVENT)\\s+([A-Za-z_]\\w*)",
			"captures": {
				"1": {
					"name": "keyword.other.prg"
				},
				"2": {
					"name": "entity.name.function.prg"
				}
			}
		},
		"class-enum-interface": {
			"match": "(?i)(?<![:.])\\b(CLASS|INTERFACE|STRUCTURE|STRUCT|ENUM)\\s+([A-Za-z_][\\w.]*)(?:\\s+(INHERIT|FROM)\\s+([\\w.]+))?(?:\\s+(IMPLEMENTS)\\s+([\\w., ]+))?",
			"captures": {
				"1": {
					"name": "keyword.other.prg"
				},
				"2": {
					"name": "entity.name.type.prg"
				},
				"3": {
					"name": "keyword.other.prg"
				},
				"4": {
					"name": "entity.name.type.prg"
				},
				"5": {
					"name": "keyword.other.prg"
				},
				"6": {
					"name": "entity.name.type.prg"
				}
			}
		},
		"namespace": {
			"match": "(?i)\\b(BEGIN\\s+NAMESPACE)\\s+([\\w.]+)",
			"captures": {
				"1": {
					"name": "keyword.other.prg"
				},
				"2": {
					"name": "entity.name.type.namespace.prg"
				}
			}
		},
		"property": {
			"match": "(?i)(?<![:.])\\b(PROPERTY)\\s+([A-Za-z_]\\w*)",
			"captures": {
				"1": {
					"name": "keyword.other.property.prg"
				},
				"2": {
					"name": "entity.name.function.prg"
				}
			}
		},
		"union-vostruct": {
			"match": "(?i)(?<![:.])\\b(MEMBER(\\s+DIM)?)\\b",
			"name": "keyword.other.prg"
		},
		"storage-modifier": {
			"match": "(?i)(?<![:.])\\b(PUBLIC|PROTECTED|PROTECT|HIDDEN|INTERNAL|SEALED|ABSTRACT|STATIC|PARTIAL|OVERRIDE|EXPORT|INSTANCE|PRIVATE|VIRTUAL|CONST|INITONLY)\\b",
			"name": "storage.modifier.prg"
		},
		"type": {
			"match": "(?i)(?<![:.])\\b(ARRAY|BINARY|BYTE|CHAR|CODEBLOCK|_CODEBLOCK|CURRENCY|DATE|DATETIME|DECIMAL|DWORD|DYNAMIC|FLOAT|INT|INT64|LOGIC|LONG|LONGINT|NINT|NUINT|OBJECT|PSZ|PTR|REAL4|REAL8|SHORT|SHORTINT|STRING|SYMBOL|UINT64|USUAL|VOID|WORD)\\b",
			"name": "storage.type.prg"
		},
		"expression": {
			"patterns": [
				{
					"match": "(?i)\\.(?:AND|OR|NOT|XOR)\\.",
					"name": "keyword.operator.logical.prg"
				},
				{
					"match": "!(?!=)",
					"name": "keyword.operator.logical.prg"
				},
				{
					"match": "(?i)(?<![:.])\\b(?:_AND|_OR|_XOR|_NOT)\\b",
					"name": "keyword.operator.bitwise.prg"
				}
			]
		},
		"variable": {
			"match": "(?i)(?<![:.])\\b(SELF|SUPER|THIS)\\b",
			"name": "variable.language.prg"
		},
		"control-keywords": {
			"patterns": [
				{
					"match": "(?i)(?<![:.])\\b(RECOVER)\\s+(USING)\\s+([A-Za-z_]\\w*)",
					"captures": {
						"1": {
							"name": "keyword.control.prg"
						},
						"2": {
							"name": "keyword.other.prg"
						},
						"3": {
							"name": "variable.other.prg"
						}
					}
				},
				{
					"match": "(?i)(?<![:.])\\b((BEGIN|END)\\s*)?(IF|SEQUENCE|CASE|WHILE|DO|FOR|LOOP|SWITCH|TRY|CATCH|WITH)\\b",
					"name": "keyword.control.prg"
				},
				{
					"match": "(?i)(?<![:.])\\b(ELSEIF|ELSE|ASYNC|AWAIT|RECOVER|BREAK|DEFAULT|OTHERWISE|EXIT|FOREACH|NEXT|NOP|REPEAT|UNTIL|RETURN|WHEN|THROW|FINALLY|YIELD)\\b",
					"name": "keyword.control.prg"
				}
			]
		},
		"as": {
			"patterns": [
				{
					"match": "(?i)(?<![:.])\\b(AS|REF|OUT|IS)\\s+(ARRAY|BINARY|BYTE|CHAR|CODEBLOCK|_CODEBLOCK|CURRENCY|DATE|DATETIME|DECIMAL|DWORD|DYNAMIC|FLOAT|INT|INT64|LOGIC|LONG|LONGINT|NINT|NUINT|OBJECT|PSZ|PTR|REAL4|REAL8|SHORT|SHORTINT|STRING|SYMBOL|UINT64|USUAL|VOID|WORD)\\b",
					"captures": {
						"1": {
							"name": "keyword.other.prg"
						},
						"2": {
							"name": "storage.type.prg"
						}
					}
				},
				{
					"match": "(?i)(?<![:.])\\b(AS|REF|OUT|IS)\\s+([A-Za-z_][\\w.]*)",
					"captures": {
						"1": {
							"name": "keyword.other.prg"
						},
						"2": {
							"name": "entity.name.type.prg"
						}
					}
				}
			]
		},
		"block": {
			"patterns": [
				{
					"match": "(?i)\\b(BEGIN|END)\\s+(USING)\\b",
					"name": "keyword.other.prg"
				},
				{
					"match": "(?i)(?<![:.])\\b((BEGIN|END)\\s+)?(CHECKED|UNCHECKED|FIXED|LOCK|NAMESPACE|SCOPE|UNSAFE|CLASS|ENUM|INTERFACE|STRUCTURE|STRUCT|UNION|VOSTRUCT|PROPERTY|GET|SET|INIT|EVENT|ADD|REMOVE|OPERATOR|CONSTRUCTOR|DESTRUCTOR|DELEGATE)\\b",
					"name": "keyword.other.prg"
				},
				{
					"include": "#using-directive"
				}
			]
		},
		"using-directive": {
			"match": "(?i)^\\s*(USING)\\s+(?:(STATIC)\\s+)?([\\w.]+)",
			"captures": {
				"1": {
					"name": "keyword.other.using.prg"
				},
				"2": {
					"name": "storage.modifier.prg"
				},
				"3": {
					"name": "entity.name.type.namespace.prg"
				}
			}
		},
		"keywords": {
			"match": "(?i)(?<![:.])\\b(ACCESS|ADD|ALIGN|AS|ASCENDING|ASPEN|ASSIGN|ASTYPE|AUTO|BEGIN|BY|CALLBACK|CATCH|CHECKED|CLASS|CLIPPER|CONST|CONSTRUCTOR|DECLARE|DEFINE|DELEGATE|DESCENDING|DESTRUCTOR|DIM|DLLEXPORT|DOWNTO|END|ENDCASE|ENDDO|ENDIF|ENUM|EQUALS|EVENT|EXPLICIT|EXTERN|FASTCALL|FIELD|FIXED|FROM|FUNC|FUNCTION|GET|GLOBAL|GROUP|IIF|IMPLEMENTS|IMPLICIT|IMPLIED|IN|INHERIT|INIT|INIT1|INIT2|INIT3|INTERFACE|INTO|IS|JOIN|LET|LOCAL|LOCK|MEMBER|MEMVAR|METHOD|NAMEOF|NAMESPACE|NEW|OF|ON|OPERATOR|ORDERBY|OUT|PARAMETERS|PARAMS|PASCAL|PROC|PROCEDURE|PROPERTY|RECORD|REF|REMOVE|SCOPE|SELECT|SET|SIZEOF|STACKALLOC|STEP|STRICT|STRUCT|STRUCTURE|THISCALL|TO|TUPLE|TYPEOF|UNCHECKED|UNION|UNSAFE|UPTO|USING|VALUE|VAR|VOLATILE|VOSTRUCT|WHERE|_CAST|_DLL|_FIELD|_INIT1|_INIT2|_INIT3|_MEMVAR|_SIZEOF|_TYPEOF|_WINCALL|__ARGLIST|__CASTCLASS)\\b",
			"name": "keyword.other.prg"
		}
	},
	"scopeName": "source.prg"
}
